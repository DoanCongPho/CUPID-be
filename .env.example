# Copy file này thành .env rồi chỉnh:  cp .env.example .env
# Lưu ý: KHÔNG có khoảng trắng quanh dấu =, KHÔNG bọc giá trị trong dấu nháy.

# --- Bắt buộc ---
# Sinh key mới: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=your_django_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (tuỳ chọn) ---
# Bỏ trống = dùng SQLite (db.sqlite3) cho local dev, không cần cài gì thêm.
# Muốn dùng Postgres/MySQL thì bỏ comment và điền:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# --- Redis (tuỳ chọn) ---
# Local dev dùng InMemoryChannelLayer, KHÔNG cần Redis.
# Chỉ cần khi bật RedisChannelLayer trong config/settings.py cho production:
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth0 (tuỳ chọn) ---
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_AUDIENCE=your-api-identifier

# --- Supabase (tuỳ chọn, dùng cho upload avatar) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
