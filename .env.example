# Copy this file to .env and fill in the values:  cp .env.example .env
# Note: no spaces around "=", and do not wrap values in quotes.

# --- Required ---
# Generate a new key:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=your_django_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (optional) ---
# Leave unset to use SQLite (db.sqlite3) for local development.
# To use Postgres/MySQL instead, uncomment one of the following:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# --- Redis (optional) ---
# Local development uses InMemoryChannelLayer, so Redis is not required.
# Only needed when RedisChannelLayer is enabled in config/settings.py.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth0 (optional) ---
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_AUDIENCE=your-api-identifier

# --- Supabase (optional, used for avatar upload) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
